<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>HaMqttDiscoverable</PackageId>
    <Version>0.1.0</Version>
    <Authors>ComputerComa</Authors>
    <Description>Create Home Assistant MQTT-discoverable devices and entities (sensors, switches, lights, numbers, and more) from C# with automatic MQTT discovery, state publishing, and command handling.</Description>
    <PackageTags>home-assistant;mqtt;iot;discovery;homeassistant</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ComputerComa/HA-MQTT-Discoverable</RepositoryUrl>
    <PackageProjectUrl>https://github.com/ComputerComa/HA-MQTT-Discoverable</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
