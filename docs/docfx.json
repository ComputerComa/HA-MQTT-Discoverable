{
  "metadata": [
    {
      "src": [
        {
          "src": "../src/HaMqttDiscoverable",
          "files": [ "HaMqttDiscoverable.csproj" ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml", "api/index.md" ]
      },
      {
        "files": [ "articles/**.md", "articles/**/toc.yml", "toc.yml", "*.md" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ]
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "globalMetadata": {
      "_appName": "HaMqttDiscoverable",
      "_appTitle": "HaMqttDiscoverable",
      "_appFooter": "HaMqttDiscoverable - Apache-2.0",
      "_enableSearch": true,
      "_gitContribute": {
        "repo": "https://github.com/ComputerComa/HA-MQTT-Discoverable",
        "branch": "main"
      }
    }
  }
}
